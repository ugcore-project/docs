{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "UgCore",
  "description": "A server-authoritative, headless and modular FiveM framework.",
  "colors": {
    "primary": "#7C5CFF",
    "light": "#9F8BFF",
    "dark": "#6342F5"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "appearance": {
    "default": "dark"
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "light": "#FBFAFF",
      "dark": "#0A0814"
    }
  },
  "fonts": {
    "heading": {
      "family": "Space Grotesk",
      "weight": 600
    },
    "body": {
      "family": "Inter"
    }
  },
  "icons": {
    "library": "fontawesome"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "dark"
  },
  "banner": {
    "content": "UgCore is in **early access**. APIs can still change before the first public release. Follow progress on [GitHub](https://github.com/ugcore-project).",
    "dismissible": true
  },
  "search": {
    "prompt": "Search UgCore docs..."
  },
  "navbar": {
    "links": [
      {
        "label": "API reference",
        "href": "/api/overview"
      }
    ],
    "primary": {
      "type": "github",
      "href": "https://github.com/ugcore-project/ug-core"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Getting started",
            "pages": [
              "index",
              "introduction",
              "installation",
              "quickstart",
              "architecture"
            ]
          },
          {
            "group": "For server owners",
