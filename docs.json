{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "maple",
  "name": "UgCore",
  "description": "A server-authoritative, headless and modular FiveM framework.",
  "colors": {
    "primary": "#7C5CFF",
    "light": "#9F8BFF",
    "dark": "#6342F5"
  },
  "favicon": "/favicon.svg",
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "/"
  },
  "appearance": {
    "default": "dark"
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "light": "#FBFAFF",
      "dark": "#0A0814"
    }
  },
  "fonts": {
