      "family": "Space Grotesk",
      "weight": 600
    },
    "body": {
      "family": "Inter"
    }
  },
  "icons": {
    "library": "fontawesome"
  },
  "styling": {
    "eyebrows": "breadcrumbs",
    "codeblocks": "dark"
  },
  "banner": {
    "content": "UgCore is in **early access**. APIs can still change before the first public release. Follow progress on [GitHub](https://github.com/ugcore-project).",
    "dismissible": true
  },
  "search": {
    "prompt": "Search UgCore docs..."
  },
  "navbar": {
    "links": [
      {
        "label": "ug-core API",
        "href": "/api/overview"
      },
      {
        "label": "ug-lib",
        "href": "/ug-lib/introduction"
      }
    ],
